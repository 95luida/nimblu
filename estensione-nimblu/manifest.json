{
  "manifest_version": 3,
  "name": "Nimblu",
  "version": "3.17.0",
  "description": "Nimblu vive sulle pagine: controlla UX, SEO, GEO, AEO e accessibilità, anche da telefono, mangia lettere e fa a botte con l'omino.",
  "permissions": [
    "storage",
    "activeTab",
    "offscreen"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Nimblu",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "mascot.js",
        "avvio.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "138",
  "background": {
    "service_worker": "background.js"
  }
}